{
  "name": "northstar-commerce-quality-framework",
  "version": "1.1.0",
  "private": true,
  "description": "Production-oriented e-commerce quality automation across UI, API, network, CI, and failure diagnostics.",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "node scripts/cypress-run.js",
    "cy:smoke": "node scripts/cypress-run.js --spec \"cypress/e2e/smoke/**/*.cy.ts\"",
    "cy:regression": "npm run cy:run",
    "pw:install": "playwright install --with-deps chromium",
    "pw:test": "playwright test --project=chromium",
    "pw:headed": "playwright test --project=chromium --headed",
    "pw:report": "playwright show-report",
    "pw:smoke": "playwright test --project=chromium --grep \"@smoke\"",
    "pw:regression": "playwright test --project=chromium",
    "pw:cross-browser": "playwright test --grep \"@smoke\"",
    "test:smoke": "npm run cy:smoke && npm run pw:smoke",
    "test:cy": "npm run cy:regression",
    "test:pw": "npm run pw:regression",
    "test": "npm run cy:regression && npm run pw:regression",
    "typecheck": "tsc --noEmit",
    "lint:waits": "node ./scripts/check-no-hard-waits.js",
    "quality": "npm run typecheck && npm run lint:waits",
    "verify": "npm run quality && npm test"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^20.12.0",
    "cypress": "^15.14.2",
    "dotenv": "^16.4.5",
    "typescript": "^5.5.4"
  }
}
