{
  "name": "northstar-commerce-quality-framework",
  "version": "1.0.0",
  "private": true,
  "description": "Production-oriented e-commerce quality automation across UI, API, network, CI, and failure diagnostics.",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "node scripts/cypress-run.js",
    "pw:install": "playwright install --with-deps chromium",
    "pw:test": "playwright test",
    "pw:headed": "playwright test --headed",
    "pw:report": "playwright show-report",
    "test:cy": "npm run cy:run",
    "test:pw": "npm run pw:test",
    "test": "npm run cy:run && npm run pw:test",
    "typecheck": "tsc --noEmit",
    "lint:waits": "node ./scripts/check-no-hard-waits.js",
    "quality": "npm run typecheck && npm run lint:waits",
    "verify": "npm run quality && npm test"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^20.12.0",
    "cypress": "^15.14.2",
    "dotenv": "^16.4.5",
    "typescript": "^5.5.4"
  }
}
