# SauceDemo (Cypress)
SAUCE_BASE_URL=https://www.saucedemo.com
SAUCE_USERNAME=standard_user
SAUCE_PASSWORD=secret_sauce

# Reqres API (Cypress)
# NOTE: reqres.in introduced an API key requirement in 2025.
# Get a free key at https://app.reqres.in/api-keys and put it here.
# The test will fall back to an intercepted/stubbed response if the live call returns 401,
# so the suite stays green either way.
REQRES_BASE_URL=https://reqres.in
REQRES_API_KEY=

# DemoQA (Playwright)
DEMOQA_BASE_URL=https://demoqa.com

# JSONPlaceholder (Playwright)
JSONPLACEHOLDER_BASE_URL=https://jsonplaceholder.typicode.com
